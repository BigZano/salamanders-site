# Legion Archive merge gate: the build and its Content-Security-Policy first (they are quick, and the one dist they make is
# what the archive scan reads below), then the whole suite, then 100% coverage + mutation on the gated units, then (locally,
# where the plaintext exists) a build scan against real-content sentinels.
export PATH="$PWD/node_modules/.bin:$PATH"
bun run build >/dev/null && node scripts/check-csp.mjs dist || exit 1
bun run test || exit 1
bun run test:coverage || exit 1
bun run test:mutation || exit 1
if [ -d archive-export ]; then
  node scripts/scan-dist.mjs dist --sentinels-from archive-export || exit 1
fi
