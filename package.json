{
  "name": "salamanders-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "cd e2e && docker compose up --build --abort-on-container-exit --exit-code-from playwright; code=$?; docker compose down -v; exit $code",
    "prepare": "husky",
    "wiki:perks": "node scripts/fetch-wiki-perks.mjs",
    "wiki:weapons": "node scripts/fetch-wiki-weapons.mjs",
    "wiki:all": "node scripts/fetch-wiki-perks.mjs && node scripts/fetch-wiki-weapons.mjs",
    "check:updates": "node scripts/check-updates.mjs",
    "discord:members": "node scripts/fetch-discord-members.mjs",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "archive": "bun scripts/seal-archive.mjs",
    "archive:dev": "bun scripts/archive-dev-server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/oswald": "^5.2.8",
    "@vue-flow/core": "^1.48.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.1",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "node-html-parser": "^9.0.1",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  }
}
