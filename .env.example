# Copy to .env (gitignored) to override for a non-local build. Not needed for
# local dev against the docker-compose stack in server/ — buildsApi.js
# already defaults to it.
#
# What a production build needs here is a bare https origin: https://host, or
# https://host:port, with no path and no trailing slash. The build puts that origin in the
# connect-src of the Content-Security-Policy it writes into index.html (scripts/csp.mjs), so the
# page may call the API and nothing else. For a build on this machine, http://localhost[:port]
# and http://127.0.0.1[:port] are accepted too (as the line below); any other address that is
# not https fails the build, with a message that names this variable.

VITE_BUILDS_API_URL=http://localhost:8787
