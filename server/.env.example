# Copy to server/.env (gitignored) and fill in before `docker compose up`.

POSTGRES_PASSWORD=

# The site's real origin, once deployed off GitHub Pages — CORS rejects
# everything else. http://localhost:5173 for local frontend dev against
# this API.
ALLOWED_ORIGIN=http://localhost:5173

# Same guild the discord-members.yml Action already syncs against.
DISCORD_GUILD_ID=1322056087792521269

# The bot's token — reuse the one already in the DISCORD_ROLE_VERIFIER GH
# secret. Unlike the static site, this server can hold it safely: it never
# ships to a browser.
DISCORD_BOT_TOKEN=

# Member reports. Discord webhook for the leadership channel; pings carry a
# report id and link only. SECRET — anyone holding it can post there.
REPORTS_WEBHOOK_URL=
# Optional overrides; defaults are XVIIILegion (files) and Reclusiarch (reviews).
REPORTER_ROLE_ID=
RECLUSIARCH_ROLE_ID=

# Leave unset for real dev/prod use — defaults to the real Discord API.
# Only the e2e/ stack sets this, pointing it at the local Discord mock.
DISCORD_API_BASE=

# Perk corrections: where the API reads the wiki bake (defaults to main on GitHub).
# BAKE_BASE_URL=https://raw.githubusercontent.com/BigZano/salamanders-site/main/src/data/
# Role overrides (defaults are the live guild's ids):
# TECHMARINE_ROLE_ID=  MECHADENDRITE_ROLE_ID=  FORGE_ROLE_ID=  HIERARCHY_ROLE_ID=
